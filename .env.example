# Docker image release tag (required for docker compose)
DHT_IMAGE_TAG=v1.12.2

# MySQL (required). The table and its search indexes are created automatically.
DHT_MYSQL_ADDRESS=your-mysql-host:3306
DHT_MYSQL_USER=your-username
DHT_MYSQL_PASSWORD=your-password
DHT_MYSQL_DATABASE=your-database
DHT_MYSQL_TABLE=info

# DHT Spider
# Forward this public UDP port to the same port on the Docker host.
DHT_PORT=6881
DHT_QUERY_WORKERS=512
DHT_QUERY_TIMEOUT=5s
DHT_METADATA_WORKERS=64
# Optional: public IP other DHT nodes see, for a BEP-42 node ID (looked up when empty).
DHT_PUBLIC_IP=
# Optional: extra DHT bootstrap nodes as host:port, comma-separated
# (not tracker announce URLs). Built-in routers are always used.
DHT_BOOTSTRAP_NODES=

# Search API
SEARCH_PORT=30080

# Spider /status and /metrics, published on 127.0.0.1 only
SPIDER_STATUS_PORT=30081
